# Humanizer local configuration.
# Copy this file to .env and fill in your key(s). Never commit .env.

# Which provider to use by default: "anthropic" or "openai".
HUMANIZER_PROVIDER=anthropic

# Anthropic (default provider).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# OpenAI (fallback provider).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Local server settings. Binds to localhost only.
HUMANIZER_HOST=127.0.0.1
HUMANIZER_PORT=8420
HUMANIZER_OPEN_BROWSER=true

# Max tokens per humanize/classify call.
HUMANIZER_MAX_TOKENS=4000

# Similarity threshold (0-1) below which a paste-back is flagged as a
# likely mismatch rather than an edit. Lower = stricter.
HUMANIZER_MISMATCH_THRESHOLD=0.35
